# Copy this file to .env and enter credentials only in that ignored local file.
# Keep Google login disabled until credentials are ready.
GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google

# CSRF token rate-limit project defaults. Tune them from production metrics and capacity.
CSRF_RATE_LIMIT_CAPACITY=20
CSRF_RATE_LIMIT_REFILL_TOKENS=20
CSRF_RATE_LIMIT_REFILL_PERIOD=1m
CSRF_RATE_LIMIT_MAX_SOURCES=4096

# Login rate-limit project defaults. Tune them from production metrics and capacity.
LOGIN_RATE_LIMIT_SOURCE_ACCOUNT_THRESHOLD=5
LOGIN_RATE_LIMIT_ACCOUNT_THRESHOLD=10
LOGIN_RATE_LIMIT_SOURCE_THRESHOLD=20
LOGIN_RATE_LIMIT_INITIAL_BACKOFF=30s
LOGIN_RATE_LIMIT_MAX_BACKOFF=1h
LOGIN_RATE_LIMIT_RECORD_TTL=1h
LOGIN_RATE_LIMIT_SOURCE_RECORD_TTL=1m
LOGIN_RATE_LIMIT_MAX_SOURCE_ACCOUNTS=16384
LOGIN_RATE_LIMIT_MAX_ACCOUNTS=32768
LOGIN_RATE_LIMIT_MAX_SOURCES=4096
